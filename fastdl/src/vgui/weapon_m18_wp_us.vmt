// Buy-menu icon for the WP marker.
//
// Looked up by weapon name - materials/vgui/inventory/<weapon>.vmt - with no way to override the
// path from the theater, so weapon_m18_wp_us needs its own file or the slot shows blank. That fixed
// path is also why this file is not content-hashed; see fastdl/tools/build.sh.
//
// Ships its own icon texture rather than tinting the green marker's. $color2 multiplied the whole
// image, the same approach that looked wrong on the can.
//
// That texture is deliberately NOT content-hashed either, and it has to match this file: a hashed
// texture behind an unhashed VMT would leave a stale client pointing at a path no longer served - a
// missing icon, which is worse than an old one. Both halves refresh together or not at all.
"UnlitGeneric"
{
	"$translucent" 1
	"$basetexture" "vgui/inventory/weapon_m18_wp_us"
	"$vertexcolor" 1
	"$vertexalpha" 1
	"$no_fullbright" 1
	"$ignorez" 1
}
