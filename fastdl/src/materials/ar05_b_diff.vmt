{
	"$basetexture"               "@@MATPATH(tex,ar05_b_diff)@@"
	"$bumpmap"                   "@@MATPATH(tex,ar05_b_ddn)@@"
	"$phongexponenttexture"      "@@MATPATH(tex,ar05_b_spec)@@"
	"$roughnessmultiplier"       "1"
	"$metal"                     "1"
	"$basemapluminancephongmask" "1"
}
