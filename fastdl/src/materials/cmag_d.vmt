// XM8 (workshop item 2019515066) - verbatim apart from the texture paths, which the build points at
// the content-hashed texture directory. See fastdl/src/models/xm8/PROVENANCE.md.
"SurfaceGGX"
{
	"$basetexture"               "@@MATPATH(tex,cmag_d)@@"
	"$bumpmap"                   "@@MATPATH(tex,cmag_n)@@"
	"$phongexponenttexture"      "@@MATPATH(tex,cmag_s)@@"
	"$roughnessmultiplier"       "1"
	"$metal"                     "1"
	"$basemapluminancephongmask" "1"
}
