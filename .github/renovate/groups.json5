{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Groups, then the digest-only group that overrides them",
  packageRules: [
    {
      description: "Go modules (all four modules): one PR",
      groupName: "go modules",
      matchManagers: ["gomod"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "The golang build images move together",
      groupName: "golang images",
      matchDatasources: ["docker"],
      matchPackageNames: ["golang"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "Third-party SourceMod plugin sources (raw files fetched by commit): one monthly PR. Any commit to the repository moves the pin, including ones that do not touch the files used",
      groupName: "sourcemod plugin sources",
      matchDatasources: ["git-refs"],
      matchDepNames: ["NullifidianSF/insurgency_public", "thecannons/Insurgency-dy-sourcemod"],
      schedule: ["* 0-3 1 * *"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },

    // After every group rule, so it takes image digest-only updates out of their groups.
    {
      description: "Image digest-only updates (same tag, new digest): one PR, held for Dashboard approval",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      groupName: "digest updates",
      groupSlug: "digest-updates",
      group: { commitMessageTopic: "digests" },
      dependencyDashboardApproval: true,
    },
  ],
}
