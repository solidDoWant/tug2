{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Approval gates and version holds for what Renovate can't regenerate",
  packageRules: [
    {
      description: "Major updates wait for a Dependency Dashboard checkbox",
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      description: "This repository's own images (the server-runner base is built by the Makefile and used as :latest); a digest pin would freeze it",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/soliddowant/**"],
      enabled: false,
    },
    {
      description: "go.mod's go line must not pass the golang image that builds the module; the golang image updates come first",
      matchManagers: ["gomod"],
      matchDepTypes: ["golang", "toolchain"],
      enabled: false,
    },
    {
      description: "PulseModel is beta software whose script vocabulary changes between versions: compare the compiled models before taking a new commit (see fastdl/Dockerfile)",
      matchDepNames: ["ToppiOfficial/PulseModel"],
      dependencyDashboardApproval: true,
    },
    {
      description: "A new SourceMod/MetaMod branch changes the plugin API and gamedata, so test it by hand",
      matchDepNames: ["alliedmodders/sourcemod", "alliedmodders/metamod-source"],
      matchUpdateTypes: ["major", "minor"],
      dependencyDashboardApproval: true,
    },
    {
      description: "Renovate cannot update this checksum (the asset name does not contain the release tag)",
      matchDepNames: ["alliedmodders/sourcemod"],
      prBodyNotes: [
        "Update `SOURCEMOD_SHA256` in **both** `Dockerfile` and `.devcontainer/Dockerfile` by hand, or the build fails at `sha256sum -c`: `v={{{newVersion}}}; curl -fsSL \"https://github.com/alliedmodders/sourcemod/releases/download/$v/sourcemod-${v%.*}-git${v##*.}-linux.tar.gz\" | sha256sum`",
      ],
    },
    {
      description: "Renovate cannot update this checksum (the asset name does not contain the release tag)",
      matchDepNames: ["alliedmodders/metamod-source"],
      prBodyNotes: [
        "Update `METAMOD_SHA256` in `Dockerfile` by hand, or the build fails at `sha256sum -c`: `v={{{newVersion}}}; curl -fsSL \"https://github.com/alliedmodders/metamod-source/releases/download/$v/mmsource-${v%.*}-git${v##*.}-linux.tar.gz\" | sha256sum`",
      ],
    },
    {
      description: "The game server's Ubuntu base: a new LTS changes glibc and the 32-bit libraries srcds needs, so test it by hand",
      matchDatasources: ["docker"],
      matchPackageNames: ["ubuntu", "ghcr.io/gameservermanagers/steamcmd"],
      matchUpdateTypes: ["major", "minor"],
      dependencyDashboardApproval: true,
    },
  ],
}
