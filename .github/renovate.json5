{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Managers: dockerfile (the server, fastdl, tools and devcontainer images),
  // gomod (the Go modules under tools/ and fastdl/tools), github-actions and
  // devcontainer. Policy is split by topic under .github/renovate/.
  extends: [
    "config:recommended",
    ":semanticCommits",
    ":timezone(America/Chicago)",
    // Applied in this order, then the packageRules below. local> presets are
    // read from the default branch.
    "local>solidDoWant/tug2//.github/renovate/safety.json5",
    "local>solidDoWant/tug2//.github/renovate/groups.json5",
    "local>solidDoWant/tug2//.github/renovate/labels.json5",
  ],

  // Hold new releases briefly (supply-chain safety, chained hotfix releases).
  // timestamp-optional: registries without release timestamps would be held forever.
  minimumReleaseAge: "3 days",
  // cspell:words Behaviour
  minimumReleaseAgeBehaviour: "timestamp-optional",
  // Expected outcome of the above; keep it out of the repository-problems list.
  logLevelRemap: [
    {
      matchMessage: "/did not have a releaseTimestamp, but as we're running with minimumReleaseAgeBehaviour=timestamp-optional/",
      newLogLevel: "debug",
    },
  ],
  suppressNotifications: ["prEditedNotification", "prIgnoreNotification"],
  // Tags can be re-pushed; a digest pins the exact content.
  pinDigests: true,

  // Replaces config:recommended's list, so the defaults are repeated.
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    ".claude/**",
    "**/docs/**",
  ],

  postUpdateOptions: ["gomodTidy"],

  // Versions that only a Dockerfile ARG holds, marked with a comment like:
  //   # renovate: datasource=github-releases depName=ErikMinekus/sm-ripext
  //   ARG RIPEXT_VERSION=1.3.2
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: ["#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*ARG\\s+[A-Z0-9_]+=(?<currentValue>\\S+)"],
    },
  ],

  packageRules: [
    // Last so it overrides any preset rule. The owner merges Renovate's PRs.
    {
      description: "Automerge disabled for everything",
      matchPackageNames: ["*"],
      automerge: false,
    },
  ],
}
