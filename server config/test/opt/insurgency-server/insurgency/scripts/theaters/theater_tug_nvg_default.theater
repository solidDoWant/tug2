				"clip_max_rounds"		"-1"	// no clips
				"clip_default"			"1"
			}

			"team_access"				"insurgent"
		}

		"weapon_m18_wp_us"
		{
			"import"					"weapon_grenade_base"
			"weapon_class"				"grenade_smoke"
			"weapon_type"				"grenade"
			"weapon_slot"				"explosive"
			"act_table"					"grenade"
			"weapon_weight"				"0"
			"weapon_cost"				"1"
			"class_restricted"			"1"

			// 1, which is TUG's value. Raising it to 2 - one half of the "carry two markers" change,
			// the other half being "carry" in the "ammo" section above - is what broke the viewmodel
			// on all three markers: no pin-pull, no throw, and the sprint pose frozen with the
			// grenade drifting and snapping back while the hand never moved.
			//
			// That was established by elimination, not by guesswork. With these blocks restated in
			// full they matched TUG's weapon_m18_us on 19 of 20 keys, and this was the twentieth.
			// Ruled out first, each against TUG's own copy: the compiled viewmodel (identical 119
			// bones in identical order, identical 15 sequences, identical activities, identical 16
			// animation events, identical per-animation bone track counts), the shared intermediate
			// base, and the third_person block.
			//
			// Raise it again only alongside "carry", and only with a way to test both markers - the
			// pair never actually delivered two grenades anyway, which is what started this.
			"weapon_max_subslot"		"1"

			"fov"
			{
				"fov_wpn_default"		"65"
			}

			"sounds"
			{
				"special1"				"Weapon_M67.SpoonEject"
			}

			"print_name"				"#weapon_m18_wp_us"
			"print_desc"				"#weapon_m18_wp_us_desc"

			// Built from source by the fastdl project: the green marker's geometry (workshop item
			// 2744181131) recompiled with $cdmaterials pointed at this repo's own material, and with
			// $modelname carrying the content hash so the engine resolves the .vvd/.vtx beside the
			// .mdl instead of at a fixed path. Both filled in at build time - see fastdl/README.md.
			//
			// FireSupport picks the mission by testing the held weapon with StrContains, first match
			// wins, so this name must not contain "m18_us" as a substring. It reads m18_wp_us, which
			// does not. Check that again if either marker is ever renamed.
			"view_model"				"@@PATH(mdl,v_m18.mdl)@@"
			"world_model"				"@@PATH(mdl,w_m18.mdl)@@"

			"explosives"
			{
				"entity"				"grenade_m18_wp_us"
			}
			"ammo_clip"
			{
