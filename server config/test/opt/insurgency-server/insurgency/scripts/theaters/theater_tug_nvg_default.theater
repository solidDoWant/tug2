	"weapons"
	{
		// Shared definition for the three signal/marker grenades.
		//
		// WHY A BASE, AND WHY FULL DEFINITIONS
		//
		// These cannot be written as partial overrides of TUG's. KeyValues allows duplicate keys, so
		// after the #base above there are two children of each name - TUG's, then ours - and the
		// parser registers each in turn with the later winning. A one-field block therefore REPLACES
		// the definition with a stub that has no import and no ammo_type, and a weapon with no ammo
		// type is unusable: it spawns with m_iPrimaryAmmoType 255 and ammo 0 (same as the knife), the
		// deploy finds nothing to equip, and the player is left holding nothing. Measured on the test
		// server: the rifle holsters, snaps back, holsters again, and no grenade ever appears.
		// Reproduced with one marker and with two, so the count was never involved.
		//
		// "IsBase" "1" is what keeps a definition from being buyable - see TUG's weapon_grenade_base.
		//
		// weapon_max_subslot is 2 here (TUG ships 0). That is one of two gates; the other is "carry"
		// in the "ammo" section above. Both are needed to actually hold two.
		//
		// Each weapon below repeats its own "explosives" and "ammo_clip" blocks in full rather than
		// adding one key to an inherited block, because whether import merges NESTED blocks or
		// replaces them is not established - and assuming merge semantics is exactly what caused the
		// bug above. Everything genuinely shared lives here.
		// ---------------------------------------------------------------------------
		// The three signal/marker grenades
		// ---------------------------------------------------------------------------
		// WRITTEN OUT IN FULL, ONE BLOCK EACH, IMPORTING weapon_grenade_base DIRECTLY - which is
		// exactly how TUG declares weapon_m18_us and weapon_m18_ins. There is no shared intermediate
		// base here, and there must not be one.
		//
		// There was: "weapon_m18_signal_base", carrying "IsBase" "1" and the fields the three have in
		// common. It reads better and it does not work. #base merging appends the INHERITED weapons
		// after the ones declared here, so "weapon_m18_signal_base" lands in the merged tree BEFORE
		// "weapon_grenade_base", and an import resolved in definition order cannot see a parent that
		// is registered later. What the three inherited was whatever the half-built intermediate
		// held. The visible result: a marker that could be bought and thrown, whose grenade flew and
		// detonated correctly, but whose viewmodel played NO activity at all - no pin-pull, no throw,
		// and the sprint pose frozen with the hand and grenade held still. A missing act_table is
		// exactly that symptom.
		//
		// The viewmodel was ruled out before changing this. Our compiled v_m18.mdl was compared with
		// TUG's workshop copy sequence by sequence: the same 15 sequences, the same activities
		// (ACT_VM_IDLE, ACT_VM_SPRINT, ACT_VM_PULLBACK_HIGH, ACT_VM_THROW, ACT_VM_HAULBACK, ...) and
		// all 16 animation events (Weapon_M67.PinPull, Weapon_M67.ArmThrow, AE_WPN_PULL_SPOON) are
		// present and identical. The single difference is that the compiler folds bakethrow onto
		// throw's animation data - 20 identical frames - which cannot stop an animation playing.
		//
		// So: no intermediate. The duplication across these three blocks buys an import that resolves
		// against a parent the game has definitely already registered. Each block is TUG's field for
		// field, with weapon_max_subslot raised and nothing else changed.

		"weapon_m18_us"
		{
			"import"					"weapon_grenade_base"
			"weapon_class"				"grenade_smoke"
			"weapon_type"				"grenade"
			"weapon_slot"				"explosive"
			"act_table"					"grenade"
			"weapon_weight"				"0"
			"weapon_cost"				"1"
			"class_restricted"			"1"

			// 1, which is TUG's value. Raising it to 2 - one half of the "carry two markers" change,
			// the other half being "carry" in the "ammo" section above - is what broke the viewmodel
			// on all three markers: no pin-pull, no throw, and the sprint pose frozen with the
			// grenade drifting and snapping back while the hand never moved.
			//
			// That was established by elimination, not by guesswork. With these blocks restated in
			// full they matched TUG's weapon_m18_us on 19 of 20 keys, and this was the twentieth.
			// Ruled out first, each against TUG's own copy: the compiled viewmodel (identical 119
			// bones in identical order, identical 15 sequences, identical activities, identical 16
			// animation events, identical per-animation bone track counts), the shared intermediate
			// base, and the third_person block.
			//
			// Raise it again only alongside "carry", and only with a way to test both markers - the
			// pair never actually delivered two grenades anyway, which is what started this.
			"weapon_max_subslot"		"1"

			"fov"
			{
				"fov_wpn_default"		"65"
			}

			"sounds"
			{
				"special1"				"Weapon_M67.SpoonEject"
			}

			"print_name"				"#weapon_m18_us"
			"print_desc"				"#weapon_m18_us_desc"
			"view_model"				"models/tug/v_m18.mdl"
			"world_model"				"models/tug/w_m18.mdl"

			"explosives"
			{
				"entity"				"grenade_m18_us"
			}
			"ammo_clip"
			{
				"ammo_type"				"grenade_m18_us_x2"
				"clip_max_rounds"		"-1"	// no clips
				"clip_default"			"1"
			}

			"team_access"				"security"
		}

		"weapon_m18_ins"
		{
			"import"					"weapon_grenade_base"
			"weapon_class"				"grenade_smoke"
			"weapon_type"				"grenade"
			"weapon_slot"				"explosive"
			"act_table"					"grenade"
			"weapon_weight"				"0"
			"weapon_cost"				"1"
			"class_restricted"			"1"

			// 1, which is TUG's value. Raising it to 2 - one half of the "carry two markers" change,
			// the other half being "carry" in the "ammo" section above - is what broke the viewmodel
			// on all three markers: no pin-pull, no throw, and the sprint pose frozen with the
			// grenade drifting and snapping back while the hand never moved.
			//
			// That was established by elimination, not by guesswork. With these blocks restated in
			// full they matched TUG's weapon_m18_us on 19 of 20 keys, and this was the twentieth.
			// Ruled out first, each against TUG's own copy: the compiled viewmodel (identical 119
			// bones in identical order, identical 15 sequences, identical activities, identical 16
