		// ================================================================================
		// Removed upgrades - see "Removed weapons" at the bottom of the "weapons" block
		// ================================================================================
		//
		// Each of these fits only weapons removed there, so it could never be bought again - but it
		// would still hold one of the 254 upgrade ids that fit m_upgradeSlots (8 bits with a -1 flag).
		// Removed the same way as the weapons: a stub that replaces TUG's definition and carries only
		// "IsBase" "1", which InitFromKV skips before assigning an id.
		"magazine_extended_pistol_16rnd"	{ "IsBase" "1" }	// Extended Magazines - Combat Commander only
		"ammo_ap_m1911"					{ "IsBase" "1" }	// AP Ammo - M1911 Series Pistol, Combat Commander
		"ammo_hp_m1911"					{ "IsBase" "1" }	// HP Ammo - M1911 Series Pistol, Combat Commander
		"m1911seriespistol_1"			{ "IsBase" "1" }	// D.O.I. Mod Edition skin
		"m45seriespistol_1"				{ "IsBase" "1" }	// Kimber Desert Warrior skin
		"ammo_ap_mini14"				{ "IsBase" "1" }	// AP Ammo - AC-556
		"ammo_hp_mini14"				{ "IsBase" "1" }	// HP Ammo - AC-556
		"ammo_tracer_mini14"			{ "IsBase" "1" }	// Tracer Ammo - AC-556
		"barrel_silencer_sten"			{ "IsBase" "1" }	// Suppressor - Sten Mk. II

		// No allowed_weapons at all, so these never fitted anything - they only held ids. The first
		// three are TUG templates nothing imports (the imported ones are restated with IsBase at the
		// top of this block); the Model 10 rounds are for a revolver this theater does not define.
		"base_ammo_slugs"				{ "IsBase" "1" }
		"base_oilfiltersilencer"		{ "IsBase" "1" }
		"base_standard"					{ "IsBase" "1" }
		"ammo_ap_model10"				{ "IsBase" "1" }	// AP Ammo - Model 10
		"ammo_hp_model10"				{ "IsBase" "1" }	// HP Ammo - Model 10

		// ================================================================================
		// GP25 underbarrel rounds fire the M203's
		// ================================================================================
		//
		// weapon_gp25_he / weapon_gp25_smoke were weapon_m203_he / weapon_m203_smoke under another
		// name: the same definition apart from print_name and the GP-30 firing sound, and their
		// explosives differ from the M203's only in the projectile's model. Pointing the GP25
		// launchers at the M203 rounds frees two weapon slots (both are stubbed out in "weapons"). What
		// is lost is the GP-30 shot sound and the VOG projectile model; the underbarrel itself - its
		// model, name and price - is unchanged. Kills now log as grenade_m203_he rather than
		// grenade_gp25_he, which bm2_respawn already treats identically.
		//
		// TUG's definitions verbatim (theater_tug_39_default_weapon_upgrades.theater), attach_weapon
		// changed. Restated in full because a definition here replaces TUG's.
		"underbarrel_gp25_he"
		{
			"import"				"underbarrel_gp25_base"
			"upgrade_cost"				"4"
			"print_name"				"#weapon_gp25_he"
			"print_desc"				"#weapon_m203_he_desc"
			"attach_weapon"				"weapon_m203_he"

			"viewmodel_attachments"
			{
				"Launcher"
				{
					"skin"					"0"
				}
			}
		}

		"underbarrel_gp25_smoke"
		{
			"import"				"underbarrel_gp25_base"
			"upgrade_cost"				"1"
			"print_name"				"#weapon_gp25_smoke"
			"print_desc"				"#weapon_m203_smoke_desc"
			"attach_weapon"				"weapon_m203_smoke"

			"viewmodel_attachments"
			{
				"Launcher"
				{
					"skin"					"1"
				}
			}
		}

		// ================================================================================
		// M79 rounds - napalm and smoke as upgrades on the one M79
		// ================================================================================
		//
		// weapon_m79_napalm and weapon_m79_smoke were weapon_m79 with a different explosive and ammo
		// pool, nothing else (the smoke also carried one fewer clip, which the ammo pool's carry of 5
		// made moot). They are stubbed out in "weapons" and come back as these two rounds, freeing two
		// weapon slots for two upgrade ids.
		//
		// WHY THE MAGAZINE SLOT. CINSWeaponRocketBase::FireRocket - every "projectile" weapon, the M79
		// included - asks for the upgrade in the magazine slot (GetUpgradeInSlot(2)) and fires its
		// explosive_override if it has one. ammo_type_override is read from a different slot (the ammo
		// slot, in CINSWeapon::GetPrimaryAmmoType), so one upgrade cannot switch both, and these do not
		// try: every round draws on the M79's own grenade_m79 pool. The napalm used to have its own
		// pool with a carry of 2 against grenade_m79's 5; maxcarry_override puts that cap back.
		//
		// TUG never uses explosive_override, so this is read out of the binary rather than copied from
		// a working example - check in game that each round fires its own projectile and that the
		// napalm stops at 2.
		//
		// Price: all three M79s cost 4, so the rounds cost nothing extra. Kills still log per
		// projectile (grenade_m79_napalm, grenade_m79_smoke), so stats and gg2_burn are unaffected.
		"magazine_m79_napalm"
		{
			"upgrade_slot"				"magazine"
			"upgrade_cost"				"0"
			"team_access"				"security, insurgent"
			"weight"					"0"

			"print_name"				"#weapon_m79_napalm"
			"print_desc"				"#weapon_m79_desc"

			"explosive_override"		"grenade_m79_napalm"
			"maxcarry_override"			"2"

			"allowed_weapons"
			{
				"weapon"				"weapon_m79"
			}
		}

		"magazine_m79_smoke"
		{
			"upgrade_slot"				"magazine"
			"upgrade_cost"				"0"
			"team_access"				"security, insurgent"
			"weight"					"0"

			"print_name"				"#weapon_m79_smoke"
			"print_desc"				"#weapon_m79_desc"

			"explosive_override"		"grenade_m79_smoke"

			"allowed_weapons"
			{
				"weapon"				"weapon_m79"
			}
		}

		// ================================================================================
		// XM8 C-Mag - 100 rounds, machine gunners only
		// ================================================================================
		//
		// Modelled on TUG's magazine_drum_75rd, the Galil SAR's drum: the XM8's viewmodel is built on
		// the Galil's animation set, so its C-Mag reload is the drum reload, selected by the same
		// "_MAG1" activity suffix (ACT_VM_RELOAD_MAG1 / ACT_VM_RELOADEMPTY_MAG1 in v_xm8.mdl).
		//
		// class_restricted "1" keeps it out of every class that does not list it in allowed_items,
		// which is only template_support_security_coop - the same class TUG gives the Galil's drum.
		//
		// The name is also the buy-menu icon's filename (materials/vgui/inventory/magazine_cmag_xm8.vmt,
		// from fastdl/src/vgui), so renaming this means renaming that.
		"magazine_cmag_xm8"
		{
			"upgrade_slot"				"magazine"
			"upgrade_cost"				"3"
			"class_restricted"			"1"
			"team_access"				"security, insurgent"
			"weight"					"0"

			"print_name"				"#weapon_upgrade_magazine_cmag"
			"print_desc"				"#weapon_upgrade_magazine_cmag_desc"

			"magsize_override"			"100"
			"maxcarry_override"			"10"

			"allowed_weapons"
			{
				"weapon"				"weapon_xm8"
			}

			"viewmodel_attachments"
			{
				"magazine_cmag_xm8"
				{
					"ActSuffix"			"_MAG1"
					"model"				"@@PATH(mdl,a_magazine_xm8_cmag.mdl)@@"
					"Main"				"1"

					"weapons"
					{
						"weapon"		"weapon_xm8"
					}
				}
			}
			"world_attachments"
			{
				"magazine_cmag_xm8"
				{
					"model"				"@@PATH(mdl,w_magazine_xm8_cmag.mdl)@@"
				}
			}
		}

		// ================================================================================
		// TUG upgrades restated so they also fit the XM8
		// ================================================================================
		//
		// Everything the Galil SAR can mount, the XM8 can: it is built on the Galil's skeleton and
		// animations, so the attachment points are the Galil's. Each block below is TUG's definition
		// verbatim with weapon_xm8 added wherever weapon_galil_sar is named - allowed_weapons,
		// attachment lists, foregrip scales, per-weapon FOV and speed-reload blocks. The exceptions (the
		// Galil's own rail mount and folded bipod, which would float off the XM8, and its bipod, which
		// is swapped for the XM8's) are listed in the script.
		//
		// Restated in full because a definition here replaces TUG's rather than merging into it. If
		// TUG Scripts is updated, rerun the script against the new theater files rather than
		// hand-editing - then rerun tools/survival-economy, which copies these.
		// ===== BEGIN GENERATED by tools/weapon-clone/generate.py - do not edit by hand =====

		// from theater_tug_39_default_weapon_upgrades.theater: weapon_xm8 added beside weapon_galil_sar
