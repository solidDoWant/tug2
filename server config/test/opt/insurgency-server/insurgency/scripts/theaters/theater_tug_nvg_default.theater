		// ---------------------------------------------------------------------------
		// Removed weapons
		// ---------------------------------------------------------------------------
		// The engine loads at most 128 weapon definitions (CTheaterWeaponDefinitions::GetMaxDefinitions,
		// on both server and client), and TUG plus this file filled all 128. Worse, a weapon's id is
		// networked as m_hWeaponDefinitionHandle in 7 unsigned bits, so id 128 arrives at the client
		// as 0 - only 127 are usable, and m_AddonModelWeaponIDs (7 bits with a -1 flag) stops at 126.
		//
		// A derived theater cannot delete an inherited definition, but it can replace one (see the note
		// atop this block), and a definition carrying "IsBase" "1" is skipped by
		// CTheaterItemBaseDefinition::InitFromKV before it is given an id - the same flag TUG's
		// weapon_base and ballistic_base use. So each stub below replaces TUG's weapon and takes no
		// slot. Nothing imports any of them; if something ever does, it will import an empty stub.
		//
		// Chosen from main-server stats, 2025-12-17 to 2026-09-25 (player kills / saved loadouts):
		// unused, duplicated by a near-identical weapon, or both. Bot classes that carried one were
		// changed with it: template_tugvar_submachinegunner_sterling is gone (its squad slots take the
		// MP40 class), the LAW sapper became template_tugvar_sapper_at4_akm and the MP5 specialist
		// template_tugvar_specialist_mp5a4. Upgrades that fitted only these weapons are removed the
		// same way at the top of "weapon_upgrades".
		//
		// Names still appear in restated upgrade lists (allowed_weapons, optics_fov_override, ...).
		// That is harmless: TUG's own lists already name weapons that were never defined (weapon_bar
		// in ammo_ap_fal, weapon_wa2000 in weapon_mod_speed_reload), and those upgrades load and work.
		"weapon_gurkha"				{ "IsBase" "1" }	// Khukuri - 0 / 0, no class gives it out
		"weapon_m1911seriespistol"	{ "IsBase" "1" }	// M1911 Series Pistol - 66 / 18
		"weapon_m45seriespistol"	{ "IsBase" "1" }	// M45 Series Pistol - 152 / 25
		"weapon_combatcommander"	{ "IsBase" "1" }	// Combat Commander - 162 / 33
		"weapon_mini14"				{ "IsBase" "1" }	// AC-556 - 336 / 7
		"weapon_sten"				{ "IsBase" "1" }	// Sten Mk. II - 252 / 11
		"weapon_sigp220"			{ "IsBase" "1" }	// SIG Sauer P220 - 135 / 17; the P226 stays
		"weapon_sterling"			{ "IsBase" "1" }	// Sterling - 199 / 8; the MP40 stays

		// Merged into a weapon that stays. The GP25 and M79 rounds come back as upgrades - see
		// "weapon_upgrades". The rest are removed outright in favour of a near-identical weapon - except
		// the MP5, which is not one: TUG's is the MP5K PDW (900 rpm, spread 0.40) against the MP5A4's
		// full-size model (800 rpm, spread 0.30, its own suppressor and SD6 mod). It goes because the
		// MP5A4 fills the same role and is used three times as much, not because nothing is lost.
		"weapon_gp25_he"			{ "IsBase" "1" }	// = weapon_m203_he but for sound and projectile model
		"weapon_gp25_smoke"			{ "IsBase" "1" }	// = weapon_m203_smoke, likewise
		"weapon_m79_napalm"			{ "IsBase" "1" }	// now magazine_m79_napalm on the M79
		"weapon_m79_smoke"			{ "IsBase" "1" }	// now magazine_m79_smoke on the M79
		"weapon_law"				{ "IsBase" "1" }	// an AT4 with another model and sound, same rocket
		"weapon_mp5"				{ "IsBase" "1" }	// MP5K PDW - 372 kills; the MP5A4 (1139) stays, see above
		"weapon_glock17"			{ "IsBase" "1" }	// Glock 17 - 303; the Glock 18 has semi too
		"weapon_l1a1"				{ "IsBase" "1" }	// L1A1 - a semi-only FAL, which stays
	}
	// ---------------------------------------------------------------------------
	// M777 white phosphorus - the fire-support shell
	// ---------------------------------------------------------------------------
	// SECURITY ONLY. There is deliberately no insurgent counterpart: the insurgent fire support is
	// themed as improvised rockets and stays on HE (grenade_m777_ins). Access is already correct
	// without any change here - FireSupport binds to weapon_m18_us, and the only security class
	// with weapon_m18_us in allowed_items is template_recon_security_coop, the Weapons Sgt.
	// Restricting the shell would be redundant; restricting the smoke is what gates the call.
	// Projectiles are theater data, not code. The HE rounds this replaces (grenade_m777_us /
	// grenade_m777_ins) are declared exactly like this in the TUG Scripts 3.9 item, under
	// theater_tug_39_custom_weapon.theater -> explosives. Nothing in the game binary knows the
	// name; addons/sourcemod/configs/firesupport.cfg names the projectile and FireSupport.sp
	// spawns it through CBaseRocketMissile::CreateRocketMissile.
	//
	// The WP round is a NEW name, so nothing inherited is matched or replaced and it is written in
	// full below. The HE rounds are NOT new, and they may not be written as one-key overrides - see
	// the note on them inside "explosives".
	//
	// The difference from HE is entity_class. grenade_frag is a blast; grenade_aoe is a persistent
	// damage field that keeps applying after detonation, which is how the stock molotov, ANM14 and
	// the 40mm grenade_m79_napalm all burn. The AreaDamage* fields below are that field.
	"explosives"
	{
		// The HE rounds, matched to the WP round's model.
		//
		// RESTATED IN FULL, and they have to be. These two were a one-key "Model" override until
		// 2026-09-14, on the assumption that #base deep-merges a partial block into the inherited
		// definition. It does not - the same assumption produced the marker-grenade bug fixed in
		// "Fix HE smokes not working", where a one-key weapon block replaced TUG's definition with
		// a stub that had no import and no ammo_type. The measured rule is the one written above
		// the "weapons" section: duplicate children do not merge, the LATER definition wins
		// outright. A one-key block is therefore a whole new definition with one key in it.
		//
		// For an explosive that means no "entity_class", and with no entity_class there is nothing
		// for CBaseRocketMissile::CreateRocketMissile to build: FireSupport's SDKCall returns no
		// entity, the plugin does not log it (see the rocket > 0 guard in Timer_FireShell), and the
		// mission silently produces the radio call and then nothing at all. Which is exactly how
		// "normal artillery doesn't work" presented. The WP mission was unaffected because
		// grenade_m777_wp_us is a new name written out in full.
		//
		// Everything below is TUG's own definition from theater_tug_39_custom_weapon.theater,
		// copied verbatim EXCEPT for "Model". Re-copy it from there if TUG Scripts is updated.
		//
		// Why the model differs: a_projectile_m203.mdl is a 40mm grenade and is close to invisible
		// falling at RocketStartSpeed 3000. The RPG-7 projectile is the largest falling-munition
		// model available and is the only warning a player gets that the ground is about to be hit.
		// Stock model, so this costs nothing - no file is added to fastdl or to the workshop item.
		"grenade_m777_us"
		{
			"import"					"baseGrenade"
			"entity_class"				"grenade_frag"
			"Model"						"models/weapons/w_rpg7_projectile.mdl"

			"DetonateDamage"			"230"
			"DetonatePenetrationRadius"	"200"
			"DetonateDamageRadius"		"1000"

			"FuseTime"					"0"
			"ImpactDetonation"			"1"
			"RocketStartSpeed"			"3000"

			"Health"					"50"
			"ReactExplosions"			"1"
			"ReactBullets"				"1"

			"Particles"
			{
				"DetonateParticle"			"ins_c4_explosion"
				"DetonateWaterParticle"		"ins_water_explosion"
			}

			"Sounds"
			{
				"DetonateSound"				"C4.Explode"
				"DetonateWaterSound"		"C4.ExplodeWater"
			}
		}

		"grenade_m777_ins"
		{
			"import"					"baseGrenade"
			"entity_class"				"grenade_frag"
			"Model"						"models/weapons/w_rpg7_projectile.mdl"

			"DetonateDamage"			"230"
			"DetonatePenetrationRadius"	"200"
			"DetonateDamageRadius"		"1000"

			"FuseTime"					"0"
			"ImpactDetonation"			"1"
			"RocketStartSpeed"			"3000"

			"Health"					"50"
			"ReactExplosions"			"1"
			"ReactBullets"				"1"

			"Particles"
			{
				"DetonateParticle"			"ins_c4_explosion"
				"DetonateWaterParticle"		"ins_water_explosion"
			}

			"Sounds"
			{
				"DetonateSound"				"C4.Explode"
				"DetonateWaterSound"		"C4.ExplodeWater"
			}
		}

		// The thrown marker that calls the WP mission. Yellow, for visibility against the dust and
		// concrete most of these maps are made of, and unambiguous against the HE marker's green.
		//
		// NOT red, which was the obvious choice: "smokegrenade_red" exists, but it is defined in
		// particles/ins_smokegrenade_red.pcf shipped by the 35AB *weapons* items (2593516111 and
		// friends), which this server does not subscribe to. Particles also have to be listed in
		// particles_manifest.txt to load at all, and that item overrides the whole manifest - so
		// shipping the effect ourselves would mean redistributing their file AND fighting every
		// other item that overrides the manifest. A particle name that does not resolve fails
		// silently as an invisible cloud, which for a marker grenade is the worst failure mode.
		//
		// The colours actually available come from 2393118985 (Masterchief, subscribed), which
		// provides exactly: smokegrenade_color, _green, _pink, _purple, _yellow. Green is the HE
		// marker and pink is the insurgent one, so yellow or purple were the real choices.
		"grenade_m18_wp_us"
		{
			"import"					"baseGrenade"
			"entity_class"				"grenade_smoke"
			"Model"						"@@PATH(mdl,w_m18.mdl)@@"
			"FuseTime"					"3.5"
			"RocketStartSpeed"			"2500"

			"Particles"
			{
				"DetonateParticle"			"smokegrenade_color_yellow"
			}

			"Sounds"
			{
				"DetonateSound"				"BaseSmokeEffect.Sound"
				"BounceSound"				"Weapon_M18.Bounce"
			}
		}

		"grenade_m777_wp_us"
		{
			"import"					"baseGrenade"
			"entity_class"				"grenade_aoe"

			// NOT the a_projectile_m203.mdl the HE M777 rounds use - that is a 40mm grenade, and
			// at this size it is close to invisible coming down. The RPG-7 projectile is the
			// largest falling-munition model available and reads as an artillery round at speed;
			// TUG's own "rocket_arty_us" entry uses it for the same reason. It is spawned pointing
			// along DOWN_VECTOR, so it falls nose-first rather than tumbling.
			//
			// Trade-off: up close it is recognisably a rocket, fins and all, rather than a shell.
			// Being visible on the way down is worth more here than being correct, because it is
			// the only warning a player gets that the ground is about to catch fire.
			"Model"						"models/weapons/w_rpg7_projectile.mdl"

			// WP is incendiary, not high explosive. The HE round is 230 damage over a 1000 radius;
			// this is a burst big enough to be lethal at the point of impact and no more. The kill
			// should come from the fire, not the bang.
			"DetonateDamage"			"50"
			"DetonatePenetrationRadius"	"14"
			"DetonateDamageRadius"		"300"
			"ShakeAmplitude"			"0"

			"FuseTime"					"0"
			"ImpactDetonation"			"1"
			"RocketStartSpeed"			"3000"
			"UseVPhysics"				"0"
			"Elasticity"				"0.0"

			// The burn. AreaDamageAmount is per tick, so the sustained figure is roughly
			// Amount / Frequency = ~39/sec to anyone standing in it, for AreaDamageTime seconds.
			// Radius grows from Min to Max at GrowSpeed, which is what gives the spreading look.
			"AreaDamageTime"			"20"
			"AreaDamageFrequency"		"0.44"
			"AreaDamageMinRadius"		"200"
			"AreaDamageMaxRadius"		"280"
			"AreaDamageGrowSpeed"		"5"
			"AreaDamageAmount"			"17"

			"Health"					"50"
			"ReactExplosions"			"1"
			"ReactBullets"				"1"

			"Particles"
			{
				"DetonateParticle"			"ins_molotov_explosion"
				"DetonateWaterParticle"		"ins_molotov_explosion"
				"FollowOrigin"				"1"
				"BroadcastAll"				"1"
			}

			"Sounds"
			{
				"DetonateSound"				"Napalm.Burn"
				"DetonateWaterSound"		"C4.ExplodeWater"
			}
		}

		// Launched smoke will not detonate until 0.06s after it leaves the tube, which at
		// RocketStartSpeed 3000 is ~180 units (roughly 3.4m) of travel. Fired at anything closer
		// than that the round is still inert on impact: it bounces off and rolls instead of popping,
		// which is what makes smoking a doorway or a window you are stacked on impossible. Zero
		// removes the delay, so the round goes off wherever it first hits.
		//
		// This covers all three smoke rounds: the two underbarrel tubes (m203 security, gp25
		// insurgent) and the standalone M79.
		//
		// The HE and incendiary rounds keep their 0.12 on purpose - that delay is the only thing
		// stopping a 40mm HE detonating in the firer's face, and it is a real safety feature rather
		// than an annoyance. Smoke has no such problem: DetonateDamage is unset, so an instant pop
		// at point-blank range hurts nobody.
		//
		// RESTATED IN FULL for the same reason as the M777 rounds above: a one-key override does not
		// merge into the inherited definition, it REPLACES it. These three were one-key "ArmDelay"
		// blocks until 2026-09-14, which left all three underbarrel smoke rounds as stubs with no
		// entity_class, no particle and no sound - i.e. silently dead, exactly like the HE artillery
		// shell. Nobody reported it because underbarrel smoke is rarely bought; it was found by
		// auditing every partial block in this file after the artillery cause was identified.
		//
		// Bodies are TUG's, from theater_tug_39_default_weapon.theater, verbatim except ArmDelay.
		// grenade_gp25_smoke keeps TUG's shape - "import" plus a model swap - because "import" is an
		// explicit directive the theater parser resolves, not #base merging, and it does work.
		"grenade_m203_smoke"
		{
			"import"					"baseGrenade"
			"entity_class"				"grenade_smoke"
			"Model"						"models/weapons/upgrades/a_projectile_m203.mdl"
			"FuseTime"					"0"
			"ImpactDetonation"			"1"
			"RocketStartSpeed"			"3000"
			"ArmDelay"					"0"

			"Health"					"50"
			"ReactExplosions"			"1"
			"ReactBullets"				"1"

			"Particles"
			{
				"DetonateParticle"			"m203_smokegrenade"
				"SmokeColor"				"40 35 33 252"
			}

			"Sounds"
			{
				"DetonateSound"				"Weapon_m203.SmokeExplode"
				"BounceSound"				"Weapon_M67.Bounce"
			}
		}

		"grenade_gp25_smoke"
		{
			"import"					"grenade_m203_smoke"
			"Model"						"models/weapons/upgrades/a_projectile_gp25.mdl"
		}

		"grenade_m79_smoke"
		{
			"import"					"baseGrenade"
			"entity_class"				"grenade_smoke"
			"Model"						"models/weapons/upgrades/a_projectile_m203.mdl"
			"FuseTime"					"0"
			"ImpactDetonation"			"1"
			"RocketStartSpeed"			"3000"
			"ArmDelay"					"0"

			"Health"					"50"
			"ReactExplosions"			"1"
			"ReactBullets"				"1"

			"Particles"
			{
				"DetonateParticle"			"m203_smokegrenade"
				"SmokeColor"				"40 35 33 252"
			}

			"Sounds"
			{
				"DetonateSound"				"Weapon_m203.SmokeExplode"
				"BounceSound"				"Weapon_M67.Bounce"
			}
		}

	}
}
