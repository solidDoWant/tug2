		// Medpack, restated IN FULL from TUG's theater_tug_39_custom_weapon.theater with one change:
		// team_access now includes insurgents (TUG: "security"). Survival puts the players on the
		// insurgent team and has no insurgent medic, so its insurgent classes list the medpack in
		// allowed_items (see theater_tug_nvg_default_survival.theater) - and the engine refuses a
		// weapon to a team that team_access leaves out, whatever allowed_items says.
		//
		// FULL, not a one-field override, for the reason at the top of this block: a partial weapon
		// definition replaces TUG's rather than merging with it. Tried on the test server - a block
		// holding only team_access left a stub with no import, ammo or explosive, and the theater
		// then loaded with 0 explosives, i.e. no grenade of any kind worked.
		//
		// Harmless outside survival: the medpack is class_restricted, and no other insurgent class
		// lists it, so insurgents elsewhere still cannot buy one. Bots buy from buy_order, which
		// never names it.
		//
		// The viewmodel is models/hlthkit/v_c4_sec.mdl - by its name, built with security hands.
		// TUG ships no insurgent variant.
		"weapon_healthkit"
		{
			"import"					"weapon_base"
			"weapon_class"				"other_explosive"
			"weapon_type"				"grenade"
			"print_name"				"#weapon_healthkit"
			"print_desc"				"#weapon_healthkit_desc"
			"single_use"				"1"
			"view_model"				"models/hlthkit/v_c4_sec.mdl"
			"world_model"				"models/hlthkit/w_c4.mdl"
			"weapon_slot"				"explosive"
			"weapon_max_subslot"		"3"	// Up to 4th slot
			"act_table"					"grenade"
			"weapon_weight"				"0"
			"weapon_cost"				"0"
			"class_restricted"			"1"

			"explosives"
			{
				"entity"				"healthkit"
				"GrenadeRollSpeed"			"0"
				"GrenadeThrowSpeed"			"320"
			}
			"ammo_clip"
			{
				"ammo_type"				"healthkit"
				"clip_max_rounds"			"-1"	// no clips
				"clip_default"				"1"
			}
			"team_access"				"security, insurgent"
		}

		// ---------------------------------------------------------------------------
		// XM8
		// ---------------------------------------------------------------------------
		// A weapon of its own, not a Galil skin. The models are workshop item 2019515066, which
		// replaced the Galil SAR's files outright; fastdl/src/models/xm8/ recompiles them under their
		// own names (see the PROVENANCE.md there), so the Galil SAR is untouched.
		//
		// TUG's weapon_galil_sar field for field, because the viewmodel is the Galil's animation set on
		// an XM8 mesh - same skeleton, same attachment points, same sound events - so the Galil's
		// handling is what the animations were timed for. Changed from TUG's:
		//
		//   - models, name and description are the XM8's
		//   - no "standard_galil" attachment: that is the Galil's folded bipod, and the XM8 has nothing
		//     to fold (the item replaced the model with an empty one)
		//
		// Sounds stay Weapon_Galil.*, which is also what the viewmodel's animation events name.
		//
		// Upgrades: every one the Galil SAR takes, restated with weapon_xm8 added (the generated block
		// in "weapon_upgrades" above), plus its own 100-round C-Mag, magazine_cmag_xm8.
		//
		// Class access: class_restricted "1", like the Galil SAR, and listed in every security class's
		// allowed_items above.
		//
		// No ammo type of its own. 556_35box is TUG's and is what the Galil uses, so this cannot hit
		// the CAmmoDef index-0 trap documented in the "ammo" section.
		"weapon_xm8"
		{
			"import"					"ballistic_base"
			"weapon_class"				"rifle_automatic_fire"
			"print_name"				"#weapon_xm8"
			"print_desc"				"#weapon_xm8_desc"
			"view_model"				"@@PATH(mdl,v_xm8.mdl)@@"
