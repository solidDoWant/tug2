	// ---------------------------------------------------------------------------
	// Artillery smoke carry capacity
	// ---------------------------------------------------------------------------
	// weapon_max_subslot caps how many of the explosive subslots - the grenade slots in the loadout
	// screen - an item may take, so it is also the carry cap. TUG ships both artillery smokes at 1,
	// which pins them to a single grenade slot; plain weapon_m18 is 3, matching the three smokes you
	// can actually carry. Raising these to 2 makes the smoke selectable in grenade slots 1 and 2 -
	// for the security green smoke that means the Sgt (#Squad_Fireteam_WeaponsSgt /
	// template_recon_security_coop, the only security class with weapon_m18_us in allowed_items) can
	// take two.
	//
	// NOTE: the exact semantics are inferred, not documented. Across the whole TUG theater the field
	// only ever holds 0, 1 or 3: 0 on launchers and C4 (which occupy the explosive slot outright),
	// 1 on most grenades, 3 on weapon_m18 and weapon_healthkit. No base class sets a default. The
	// 1 -> 2 direction is right under any of the readings that fit that data, but if a smoke turns
	// up in an unexpected number of slots in game, this field is why.
	//
	// These two are the weapons FireSupport is bound to in configs/firesupport.cfg
	// (security_smoke -> m18_us, insurgent_smoke -> m18_ins), so m18_ins raises what insurgent bot
	// specialists can bring as well.
	//
	// Unlike the allowed_items restatements above, this override is safe to write as a partial
	// block: #base merges by child NAME, and "weapons", each weapon name and "weapon_max_subslot"
	// are each unique within their parent. Only that one field is replaced; models, fov, cost and
	// everything else are inherited untouched.
	// ---------------------------------------------------------------------------
	// Slings out of the accessory slot, night vision left in it
	// ---------------------------------------------------------------------------
	// TUG's gear file puts sec_nightvision AND all three slings in "accessory", and a gear slot
	// holds exactly one item (there is no gear equivalent of weapon_max_subslot), so buying NVGs
	// costs a player their sling. Something has to move.
	//
	// It has to be the slings. "accessory" is the only gear slot the game can activate: the client
	// registers exactly one gear-use command, +use_accessory - "Toggle Player Accessory" - and there
	// is no +use_misc1 or +use_misc2 anywhere in client.so. gear_misc1 and gear_misc2 exist there
	// only as inventory UI panel names. Anything needing a keypress is unusable outside "accessory",
	// which is what moving the NVGs out got wrong: they could be bought and never switched on.
	//
	// The slings do not care. Each one's whole effect is a weapon_slots modifier applied when it is
	// equipped - primary 1, secondary 1, or primary -1 / secondary 2 - with no entity and nothing to
	// toggle, so a slot with no key costs them nothing.
	//
	// misc1 is a real slot, not an invention. The server's gear_slot name-to-index table (7 entries at
	// .data.rel.ro+0xbed880, read by the converter at 0x29e940) is exactly:
	//
	//     armor 0   head 1   vest 2   accessory 3   backpack 4   misc1 5   misc2 6
	//
	// An unrecognised name returns -1 from that converter and would be used as an array subscript, so
	// the spelling matters; "misc1" resolves to 5. Nothing in any content uses head, backpack, misc1
	// or misc2 - not TUG, not the workshop, not Valve's own theaters - but the client's inventory UI
	// defines a CInventoryGearSlot panel for each, and misc1 renders: GEAR_SLOT_MISC1 in this repo's
	// localisation is the label it asks for.
	//
	// The bonus applies from misc1. CPlayerInventory::GetWeaponSlotCapacity (0x2cf7b0) starts at 1 and
	// walks m_EquippedGear[0..6] unconditionally - "cmp $0x7" is the loop bound - adding each equipped
	// item's weaponSlotBonus[weaponSlot] from gearDef+0x49c. The gear slot is only ever an array
	// subscript there; nothing compares it against accessory. The purchase-time check at 0x2cff3b uses
	// it the same way, plus a per-slot lock byte at inventory+0x2c that comes from the theater's
	// locked_gear_slots - which no theater here sets, so no slot is locked.
	//
	// EACH SLING IS RESTATED IN FULL, and deliberately so. An earlier version of this block set only
	// "gear_slot" per sling, on the reasoning that #base merges by child name. That reasoning is not
	// safe: the "weapons" block below documents the opposite behaviour, MEASURED on this server -
	// duplicate keys both survive, the parser registers each in turn, and the later one wins OUTRIGHT,
	// so a one-field block leaves a stub. Applied to a sling that would have discarded weapon_slots,
	// which is the sling's entire purpose, along with its name, cost, weight and team_access - the
	// items would still occupy misc1 and grant nothing.
	//
	// Restating in full is correct under EITHER semantics: if the parser really does merge, these
	// values are identical to the inherited ones and nothing changes; if it replaces, everything the
	// sling needs is present. The cost is the usual one - if TUG changes a sling, re-extract it from
	// theater_tug_39_default_gear.theater rather than hand-merging. Only gear_slot differs from TUG.
	//
	// sec_nightvision is deliberately absent here - it stays where TUG puts it, in "accessory".
	// ins_nightvision likewise: it is the insurgent item and insurgents are bots in checkpoint.
	"player_gear"
	{
		"primary_sling"
		{
			"print_name"				"#primary_sling"
			"print_desc"				"#primary_sling_desc"
			"gear_slot"					"misc1"
			"gear_cost"					"0"
			"gear_weight"				"0"	// 4 (0.65 kg) * 54.5
			"weapon_slots"
			{
				"primary"				"1"
			}
			"team_access"				"security"
		}

		"secondary_sling"
		{
			"print_name"				"#secondary_sling"
			"print_desc"				"#secondary_sling_desc"
			"gear_slot"					"misc1"
			"gear_cost"					"0"
			"gear_weight"				"0"	// 4 (0.65 kg) * 54.5
			"weapon_slots"
			{
				"secondary"				"1"
			}
			"team_access"				"security"
		}

		"secondary2_sling"
		{
			"print_name"				"#secondary2_sling"
			"print_desc"				"#secondary2_sling_desc"
			"gear_slot"					"misc1"
			"gear_cost"					"0"
			"gear_weight"				"0"	// 4 (0.65 kg) * 54.5
			"weapon_slots"
			{
				"primary"				"-1"
				"secondary"				"2"
			}
			"team_access"				"security"
		}
	}

	// Carry counts. TWO separate things gate how many grenades a player ends up with, and both have
	// to be raised together:
	//
	//   weapon_max_subslot  how many grenade slots the item may occupy   (in "weapons", below)
	//   carry               the hard cap on how many are actually given  (here)
	//
	// Raising only the first is why buying two arty smokes granted one. TUG ships grenade_m18_us
	// and grenade_m18_ins at carry 1 - they are the ONLY throwables in the whole set at 1 apart
	// from C4 and the Geballteladung, which are single-use by design. Every comparable grenade sits
	// at subslot+1 or better: weapon_molotov and weapon_anm14 are subslot 1 / carry 2, the stock
	// weapon_m18 is subslot 3 / carry 4.
	//
	// An ammo_type with no entry here cannot be carried at all - the weapon is refused at spawn
	// with "Invalid player".
	"ammo"
	{
		"grenade_m18_us"
		{
			"carry"					"2"
		}
		"grenade_m18_ins"
		{
			"carry"					"2"
		}
		// Same pair of gates as above - this one was introduced with the same mistake, since it was
		// copied from the green marker before the cause was understood.
		"grenade_m18_wp_us"
		{
			"carry"					"2"
		}

		// ================================================================================
		// .50 BMG heavy ammunition for the M107 - see gg2_heavy_ammo.sp
		// ================================================================================
		//
		// The rifle itself needs nothing here. weapon_M107 is "class_restricted" "0", which is what
		// makes it buyable without appearing in any class's allowed_items - every class_restricted
		// "1" weapon in this theater is listed, and most of the "0" ones are not. Do not "fix" its
		// absence from the lists below by adding it; it is already available.
		//
		// These are NEW names, so the partial-block rule is satisfied trivially: #base merges by
		// child NAME and nothing inherited is called any of these, so the stock 50_bmg, _hp and _ap
		// entries are untouched and remain selectable.
		//
		// The area effect is NOT here. Nothing in an ammo definition can make a bullet explode -
		// "damageType" only relabels the damage, and bullets are hitscan traces with no projectile
		// to detonate. These entries supply the round's ballistics, scarcity and suppression; the
		// blast and the fire come from the plugin, which recognises the round by its ammo type.
		//
		// SuppressionIncrement is the game's own per-bullet suppression, applied to whatever the
		// round passes near. It is raised over the 330 of standard .50 BMG because both of these
		// are meant to be frightening to be shot at with, independently of what the plugin adds.

		// Mk 211 Mod 0 HEIAP. Real ones carry a zirconium incendiary and an RDX/HMX charge behind a
		// tungsten penetrator, so: penetration close to AP, slightly less direct damage than AP
		// because some of the projectile mass is filler, and the difference made up by the blast.
		"50_bmg_mk211"
		{
			"import"				"50_bmg_ap"
			"SuppressionIncrement"	"450"
			"DamageHitgroups"
			{
				"HITGROUP_HEAD"       "7.6"
				"HITGROUP_CHEST"      "7.5"
				"HITGROUP_STOMACH"    "7.5"
				"HITGROUP_LEFTARM"    "2.8"
				"HITGROUP_RIGHTARM"   "2.8"
				"HITGROUP_LEFTLEG"    "2.8"
				"HITGROUP_RIGHTLEG"   "2.8"
			}
		}

		// M8 API. Armour-piercing incendiary with no explosive filler - it starts fires, it does not
		// burst. Ballistically it is the AP round, which is why it inherits it unchanged.
		"50_bmg_api"
		{
			"import"				"50_bmg_ap"
			"SuppressionIncrement"	"380"
		}

		// The magazine variants are what a weapon actually references. carry is deliberately below
		// the 10 of "50_bmg_ap_mag": both rounds are strictly better than AP once the plugin is
		// involved, so scarcity is the balance lever rather than damage numbers.
		"50_bmg_mk211_mag"
		{
			"import"				"50_bmg_mk211"
			"carry"					"5"
			"magsize"				"11"
		}

		"50_bmg_api_mag"
		{
			"import"				"50_bmg_api"
			"carry"					"7"
			"magsize"				"11"
		}

		// SHOTGUN AMMUNITION - the three buckshot/slug types restated IN FULL to add one missing field.
		//
		// Without this, every shotgun on the server spawns with a full tube and NOTHING to reload from.
		// Measured: a purchased weapon_m1014 held clip=4 reserve=0, sampled repeatedly with the tube
		// never moving, and weapon_m590 and weapon_toz are confirmed affected in play. All three report
		// the same ammo type index, so it is one shared pool sitting empty.
		//
		// THE MISSING FIELD IS magsize, and the evidence is a controlled comparison rather than a guess.
		// Reserve is granted as clip_default plus the equipped gear's extra_ammo for that weapon slot -
		// confirmed three times (deagle 4 + no gear = 4; m60 3 + chest_rig primary 2 = 5; ak74 4 +
		// chest_carrier primary 4 = 8). It works for every loose-fed PRIMARY (mosin, m40a1, kar98,
		// enfield) even though those types declare no magsize either. What separates the working from the
		// broken is the SECONDARY slot:
		//
		//     weapon_cobra    357, loose, secondary, magsize 6 declared   -> 42 reserve (= 357's carry)
		//     weapon_m590     4buckshot, loose, secondary, NO magsize     -> 0
		//     weapon_toz      4buckshot, loose, secondary, NO magsize     -> 0
		//     weapon_m1014    4buckshot, loose, secondary, NO magsize     -> 0
		//
		// 4buck and 762x54 BOTH inherit "magsize" "30" from the "default" ammo base, so the inherited
		// value is not what distinguishes the mosin from the shotguns - the slot is. A loose-fed
		// secondary needs a real magsize; a rifle magazine of 30 for 12-gauge shells is not one.
		//
		// WHY 8: magsize is the weapon's load, and carry is a whole number of loads - 357 is 6 with carry
		// 42 (7 loads), 38special 6 with carry 48 (8), saiga_4buckshot 8 with carry 12. Of the weapons
		// sharing 4buckshot, four hold 8 (m590, m500, spas12, nova), toz holds 6 and m1014 holds 4, and
		// carry 72 is exactly 9 x 8. One ammo type cannot express three different tube sizes; if the
		// m1014 specifically needs its own figure later, the pattern to copy is saiga_4buckshot, which is
		// a separate type precisely because that weapon differs.
		//
		// RESTATED IN FULL because duplicate keys do not merge here - the later definition wins outright,
		// so import, carry and flags_clear must be repeated or they are lost. Only magsize is new.
		//
		// 00buckshot and rifledslugs are the purchasable shotgun ammo upgrades and have the identical
		// shape, so they would fail the identical way once bought. Verify all three with ammo_probe.
		"4buckshot"
		{
			"import"				"4buck"
			"carry"					"72"
			"magsize"				"8"
			"flags_clear"			"AMMO_USE_MAGAZINES"
		}

		"00buckshot"
		{
			"import"				"00buck"
			"carry"					"72"
			"magsize"				"8"
			"flags_clear"			"AMMO_USE_MAGAZINES"
		}

		"rifledslugs"
		{
			"import"				"rifledslug"
			"carry"					"72"
			"magsize"				"8"
			"flags_clear"			"AMMO_USE_MAGAZINES"
		}

	}

	// ================================================================================
	// Heavy .50 ammunition, as buyable upgrades in the M107's "ammo" slot
	// ================================================================================
	//
	// Same shape as TUG's own ammo_hp_m107 / ammo_ap_m107: import the AP base for the slot and
	// wiring, restrict to one weapon with allowed_weapons, and point ammo_type_override at the new
	// ammo. Both names are new, so this whole block merges in without displacing anything.
	//
	// allowed_weapons says "weapon_m107" in lower case purely to match how every other upgrade in
	// TUG's file spells it; the definition itself is "weapon_M107".
	"weapon_upgrades"
	{
		"ammo_mk211_m107"
		{
			"import"				"base_ammo_ap"
			"upgrade_cost"			"4"
			"print_name"			"#weapon_upgrade_mk211"
			"print_desc"			"#weapon_upgrade_mk211_desc"
			"allowed_weapons"
			{
				"weapon"			"weapon_m107"
			}
			"ammo_type_override"	"50_bmg_mk211_mag"
		}

		"ammo_api_m107"
		{
			"import"				"base_ammo_ap"
			"upgrade_cost"			"3"
			"print_name"			"#weapon_upgrade_api"
			"print_desc"			"#weapon_upgrade_api_desc"
			"allowed_weapons"
			{
				"weapon"			"weapon_m107"
			}
			"ammo_type_override"	"50_bmg_api_mag"
		}
	}

	"weapons"
	{
		// Shared definition for the three signal/marker grenades.
		//
		// WHY A BASE, AND WHY FULL DEFINITIONS
		//
		// These cannot be written as partial overrides of TUG's. KeyValues allows duplicate keys, so
		// after the #base above there are two children of each name - TUG's, then ours - and the
		// parser registers each in turn with the later winning. A one-field block therefore REPLACES
		// the definition with a stub that has no import and no ammo_type, and a weapon with no ammo
		// type is unusable: it spawns with m_iPrimaryAmmoType 255 and ammo 0 (same as the knife), the
		// deploy finds nothing to equip, and the player is left holding nothing. Measured on the test
		// server: the rifle holsters, snaps back, holsters again, and no grenade ever appears.
		// Reproduced with one marker and with two, so the count was never involved.
		//
		// "IsBase" "1" is what keeps a definition from being buyable - see TUG's weapon_grenade_base.
		//
		// weapon_max_subslot is 2 here (TUG ships 0). That is one of two gates; the other is "carry"
		// in the "ammo" section above. Both are needed to actually hold two.
		//
		// Each weapon below repeats its own "explosives" and "ammo_clip" blocks in full rather than
		// adding one key to an inherited block, because whether import merges NESTED blocks or
		// replaces them is not established - and assuming merge semantics is exactly what caused the
		// bug above. Everything genuinely shared lives here.
		"weapon_m18_signal_base"
		{
			"IsBase"					"1"
			"import"					"weapon_grenade_base"
			"weapon_class"				"grenade_smoke"
			"weapon_type"				"grenade"
			"weapon_slot"				"explosive"
			"weapon_max_subslot"		"2"
			"act_table"					"grenade"
			"weapon_weight"				"0"
			"weapon_cost"				"1"
			"class_restricted"			"1"

			"fov"
			{
				"fov_wpn_default"		"65"
			}

			"sounds"
			{
				"special1"				"Weapon_M67.SpoonEject"
			}

			"third_person"
			{
				"reticle"				"ss_crosshairs/smoke_grenade"
				"scope_first_person"	"1"

				"recoil_frac_aim"		"0.08"
				"recoil_frac_cam_pitch"	"0.04"
				"recoil_frac_cam_yaw"	"0.06"

				"spread_frac_speed"		"1.0"
				"spread_frac_spray"		"0.2"
			}
		}

		"weapon_m18_us"
		{
			"import"					"weapon_m18_signal_base"
			"print_name"				"#weapon_m18_us"
			"print_desc"				"#weapon_m18_us_desc"
			"view_model"				"models/tug/v_m18.mdl"
			"world_model"				"models/tug/w_m18.mdl"

			"explosives"
			{
				"entity"				"grenade_m18_us"
			}
			"ammo_clip"
			{
				"ammo_type"				"grenade_m18_us"
				"clip_max_rounds"		"-1"
				"clip_default"			"1"
			}

			"team_access"				"security"
		}

		"weapon_m18_ins"
		{
			"import"					"weapon_m18_signal_base"
			"print_name"				"#weapon_m18_ins"
			"print_desc"				"#weapon_m18_ins_desc"
			"view_model"				"models/tug/v_m18_ins.mdl"
			"world_model"				"models/tug/w_m18_ins.mdl"

			"explosives"
			{
				"entity"				"grenade_m18_ins"
			}
			"ammo_clip"
			{
				"ammo_type"				"grenade_m18_ins"
				"clip_max_rounds"		"-1"
				"clip_default"			"1"
			}

			"team_access"				"insurgent"
		}

		// The WP marker. FireSupport picks a support type by testing the HELD weapon's classname
		// against the "weapon" key in configs/firesupport.cfg with StrContains, first match wins -
		// so these two have to be distinguishable as substrings. "weapon_m18_wp_us" does not
		// contain "m18_us" (it reads m18_wp_us), so the HE entry cannot swallow the WP throw.
		// Renaming either one means rechecking that.
		"weapon_m18_wp_us"
		{
			"import"					"weapon_m18_signal_base"
			"print_name"				"#weapon_m18_wp_us"
			"print_desc"				"#weapon_m18_wp_us_desc"

			// Built from source by the fastdl project: the green marker's geometry (workshop item
			// 2744181131) recompiled with $cdmaterials pointed at this repo's own material. The
			// paths below are content-hashed and filled in at build time - see fastdl/README.md.
			// That material tints in place and references the ORIGINAL textures, so no texture or
			// model art is duplicated - see the VMT for the tint and its caveat.
			//
			// Only the $cdmaterials path and the .mdl's own internal name were changed, and both
			// replacements are byte-for-byte the same length. A .mdl addresses most of its strings
			// by offset, so a length change there corrupts the file silently.
			"view_model"				"@@PATH(mdl,v_m18.mdl)@@"
			"world_model"				"@@PATH(mdl,w_m18.mdl)@@"


			"explosives"
			{
				"entity"				"grenade_m18_wp_us"
			}
			"ammo_clip"
			{
				"ammo_type"				"grenade_m18_wp_us"
				"clip_max_rounds"		"-1"	// no clips
				"clip_default"			"1"
			}


			"team_access"				"security"
		}

		// KSG - restated IN FULL to correct clip_default, which TUG ships as 0.
		//
		// 0 means the weapon is handed out with a full tube and literally nothing spare, by configuration
		// rather than by the ammo-type bug fixed in the "ammo" block above. Confirmed unintentional. The
		// two faults are independent and the KSG had both, so it needs this as well as the magsize fix.
		//
		// 42 is three tube-loads, which is what every other pump in this theater is given - m590 8 -> 24,
		// m500 8 -> 24, spas12 8 -> 24, nova 8 -> 24, toz 6 -> 18. The KSG's tube is 14, so 3 x 14 = 42,
		// and that still fits under its own clip_max (48) and 4buckshot's carry (72).
		//
		// ONE THING TO WATCH: the KSG's 14-round tube is the odd one out against the shared magsize of 8
		// that 4buckshot now declares (chosen because four of the six weapons sharing it hold 8). If the
		// KSG specifically still misbehaves after deploying, that mismatch is the first suspect, and the
		// remedy is its own ammo type modelled on saiga_4buckshot rather than moving the shared magsize.
		//
		// RESTATED IN FULL because duplicate keys do not merge here - the later definition wins outright,
		// so a one-field block would leave a stub with no import, model or ammo_type. TUG 3.9's definition
		// verbatim apart from clip_default; re-extract from theater_tug_39_custom_weapon.theater if TUG
		// is updated.

		"weapon_ksg"
		{
			"import"					"ballistic_base"
			"weapon_class"				"shotgun"
			"weapon_cost"				"1"
			"print_name"				"#weapon_ksg"
			"print_desc"				"#weapon_ksg_desc"
			"view_model"				"models/weapons/v_ksg.mdl"
			"world_model"				"models/weapons/w_ksg.mdl"
			"fire_cycle"				"0.15"
			"weapon_slot"				"secondary"
			"weapon_max_subslot"			"1"	// Up to the 2nd subslot only
			"act_table"					"shot"
			"weapon_abilities"			"ironsight"
			"weapon_weight"				"0"	// (2.5kg[weapon] + (0.3kg[ammo] * (1+10)[mags]) )*10[kg->hg for int]  +24[encumbrance]
			"barrel_length"				"0"
			"class_restricted"			"0"
			
			"viewmodel_attachments"
			{
				"rearsight"
				{
					"model"					"models/weapons/upgrades/a_standard_ksg.mdl"
					"fallback_for_slot"		"optics"
				}
			}
			"fov"
			{
				"fov_wpn_scope"				"0"
				"fov_plr_ironsight"			"-25"
				"fov_plr_focus"				"-12"
				"fov_wpn_default"			"54"
				"fov_wpn_ironsight"			"74"
				"fov_wpn_focus"				"79"
			}
			"sounds"
			{
				"shot_single"				"Weapon_m590.Single"
				"shot_single_local"			"Weapon_TOZ.SingleLocal"
				"shot_silent"				"Weapon_m590.SingleSilenced"
				"shot_silent_local"			"Weapon_m590.SingleSilencedLocal"
				"empty"						"Weapon_mk18.Empty"
				"boltback"					"Weapon_mk18.BoltBack"
				"boltrelease"				"Weapon_mk18.BoltRelease"
			}
			"particles"
			{
				"particle_muzzleflash_1st"		"muzzleflash_m590_1p"
				"particle_muzzleflash_3rd"		"muzzleflash_m590_3rd"
			}
			"recoil"
			{
				"recoil_lateral_range"			"-1.0 1.25"
				"recoil_vertical_range"			"10.00 10.75"
				"recoil_aim_punch"				"0.8 1.4"
				"recoil_rest_rate"				"24"
				"recoil_rest_delay"				"0.15"
				"recoil_roll_range"				"-1.50 -1.50"
				"recoil_roll_rest_rate"			"150"
				"recoil_freeaim_frac"			"0.1"
				
				"recoil_additional_rest_per_shot"	"2.5"	// Amount of rest per additional shot (added to rest rate) (default = 2.5)
				"recoil_shot_reset_time"			"0.3"	// Time delay for resetting the shots fired counter for the above (default = 0.3)
				"recoil_shot_max_shots"				"5"	// Max number of shots to account for for the additional rest (default = 5)
				"recoil_punch_additive_factor"		"0.85"	// How much of the view punch from the previous shot(s) get added to any additional shot fired.
			}
			"ballistics"
			{
				"spread"				"1.5 4.2 0.0"
				"FireModes"				"pump"
				"maxrange"				"8000"
				"singleReload"			"1"
				"tacticalreload"		"1"
			}
			"ammo_clip"
			{
				"ammo_type"				"4buckshot"
				"clip_max"				"48"
				"clip_max_rounds"		"14"
				"clip_default"			"42"
			}
			"attachments"
			{
				"attachment_addon"		"primary"
			}
			"kitui_offset"
			{
				"position"				"28 0 3"
			}
			"team_access"				"security, insurgent"
		}	
	}
	// ---------------------------------------------------------------------------
	// M777 white phosphorus - the fire-support shell
	// ---------------------------------------------------------------------------
	// SECURITY ONLY. There is deliberately no insurgent counterpart: the insurgent fire support is
	// themed as improvised rockets and stays on HE (grenade_m777_ins). Access is already correct
	// without any change here - FireSupport binds to weapon_m18_us, and the only security class
	// with weapon_m18_us in allowed_items is template_recon_security_coop, the Weapons Sgt.
	// Restricting the shell would be redundant; restricting the smoke is what gates the call.
	// Projectiles are theater data, not code. The HE rounds this replaces (grenade_m777_us /
	// grenade_m777_ins) are declared exactly like this in the TUG Scripts 3.9 item, under
	// theater_tug_39_custom_weapon.theater -> explosives. Nothing in the game binary knows the
	// name; addons/sourcemod/configs/firesupport.cfg names the projectile and FireSupport.sp
	// spawns it through CBaseRocketMissile::CreateRocketMissile.
	//
	// Safe as a partial block, for the same reason the "weapons" override below is: #base merges
	// by child NAME, and "explosives" plus each shell name are unique within their parent. These
	// are NEW names, so nothing inherited is matched or replaced - the HE rounds stay defined and
	// can be switched back to from the plugin config alone, with no theater change.
	//
	// The difference from HE is entity_class. grenade_frag is a blast; grenade_aoe is a persistent
	// damage field that keeps applying after detonation, which is how the stock molotov, ANM14 and
	// the 40mm grenade_m79_napalm all burn. The AreaDamage* fields below are that field.
	"explosives"
	{
		// The HE rounds, matched to the WP round's model.
		//
		// These are TUG's, defined in theater_tug_39_custom_weapon.theater, and only the Model is
		// replaced here - damage, radii, fuse, particles and sounds are all inherited untouched.
		// Safe as a partial block for the usual reason: #base merges by child NAME, and
		// "explosives", each shell name and "Model" are unique within their parent.
		//
		// Same reasoning as the WP round: a_projectile_m203.mdl is a 40mm grenade and is close to
		// invisible falling at RocketStartSpeed 3000. The RPG-7 projectile is the largest
		// falling-munition model available and is the only warning a player gets that the ground is
		// about to be hit. Stock model, so this costs nothing - the workshop item gains no files.
		"grenade_m777_us"
		{
			"Model"						"models/weapons/w_rpg7_projectile.mdl"
		}
		"grenade_m777_ins"
		{
			"Model"						"models/weapons/w_rpg7_projectile.mdl"
		}

		// The thrown marker that calls the WP mission. Yellow, for visibility against the dust and
		// concrete most of these maps are made of, and unambiguous against the HE marker's green.
		//
		// NOT red, which was the obvious choice: "smokegrenade_red" exists, but it is defined in
		// particles/ins_smokegrenade_red.pcf shipped by the 35AB *weapons* items (2593516111 and
		// friends), which this server does not subscribe to. Particles also have to be listed in
		// particles_manifest.txt to load at all, and that item overrides the whole manifest - so
		// shipping the effect ourselves would mean redistributing their file AND fighting every
		// other item that overrides the manifest. A particle name that does not resolve fails
		// silently as an invisible cloud, which for a marker grenade is the worst failure mode.
		//
		// The colours actually available come from 2393118985 (Masterchief, subscribed), which
		// provides exactly: smokegrenade_color, _green, _pink, _purple, _yellow. Green is the HE
		// marker and pink is the insurgent one, so yellow or purple were the real choices.
		"grenade_m18_wp_us"
		{
			"import"					"baseGrenade"
			"entity_class"				"grenade_smoke"
			"Model"						"@@PATH(mdl,w_m18.mdl)@@"
			"FuseTime"					"3.5"
			"RocketStartSpeed"			"2500"

			"Particles"
			{
				"DetonateParticle"			"smokegrenade_color_yellow"
			}

			"Sounds"
			{
				"DetonateSound"				"BaseSmokeEffect.Sound"
				"BounceSound"				"Weapon_M18.Bounce"
			}
		}

		"grenade_m777_wp_us"
		{
			"import"					"baseGrenade"
			"entity_class"				"grenade_aoe"

			// NOT the a_projectile_m203.mdl the HE M777 rounds use - that is a 40mm grenade, and
			// at this size it is close to invisible coming down. The RPG-7 projectile is the
			// largest falling-munition model available and reads as an artillery round at speed;
			// TUG's own "rocket_arty_us" entry uses it for the same reason. It is spawned pointing
			// along DOWN_VECTOR, so it falls nose-first rather than tumbling.
			//
			// Trade-off: up close it is recognisably a rocket, fins and all, rather than a shell.
			// Being visible on the way down is worth more here than being correct, because it is
			// the only warning a player gets that the ground is about to catch fire.
			"Model"						"models/weapons/w_rpg7_projectile.mdl"

			// WP is incendiary, not high explosive. The HE round is 230 damage over a 1000 radius;
			// this is a burst big enough to be lethal at the point of impact and no more. The kill
			// should come from the fire, not the bang.
			"DetonateDamage"			"50"
			"DetonatePenetrationRadius"	"14"
			"DetonateDamageRadius"		"300"
			"ShakeAmplitude"			"0"

			"FuseTime"					"0"
			"ImpactDetonation"			"1"
			"RocketStartSpeed"			"3000"
			"UseVPhysics"				"0"
			"Elasticity"				"0.0"

			// The burn. AreaDamageAmount is per tick, so the sustained figure is roughly
			// Amount / Frequency = ~39/sec to anyone standing in it, for AreaDamageTime seconds.
			// Radius grows from Min to Max at GrowSpeed, which is what gives the spreading look.
			"AreaDamageTime"			"20"
			"AreaDamageFrequency"		"0.44"
			"AreaDamageMinRadius"		"200"
			"AreaDamageMaxRadius"		"280"
			"AreaDamageGrowSpeed"		"5"
			"AreaDamageAmount"			"17"

			"Health"					"50"
			"ReactExplosions"			"1"
			"ReactBullets"				"1"

			"Particles"
			{
				"DetonateParticle"			"ins_molotov_explosion"
				"DetonateWaterParticle"		"ins_molotov_explosion"
				"FollowOrigin"				"1"
				"BroadcastAll"				"1"
			}

			"Sounds"
			{
				"DetonateSound"				"Napalm.Burn"
				"DetonateWaterSound"		"C4.ExplodeWater"
			}
		}

		// Launched smoke will not detonate until 0.06s after it leaves the tube, which at
		// RocketStartSpeed 3000 is ~180 units (roughly 3.4m) of travel. Fired at anything closer
		// than that the round is still inert on impact: it bounces off and rolls instead of popping,
		// which is what makes smoking a doorway or a window you are stacked on impossible. Zero
		// removes the delay, so the round goes off wherever it first hits.
		//
		// This covers all three smoke rounds: the two underbarrel tubes (m203 security, gp25
		// insurgent) and the standalone M79.
		//
		// The HE and incendiary rounds keep their 0.12 on purpose - that delay is the only thing
		// stopping a 40mm HE detonating in the firer's face, and it is a real safety feature rather
		// than an annoyance. Smoke has no such problem: DetonateDamage is unset, so an instant pop
		// at point-blank range hurts nobody.
		//
		// Safe as a partial block for the usual reason: #base merges by child NAME and takes the
		// FIRST match, and "explosives", each round name and "ArmDelay" are unique within their
		// parent - everything else about these rounds is inherited untouched.
		//
		// grenade_gp25_smoke is defined by TUG as `"import" "grenade_m203_smoke"` plus a model swap,
		// so it would likely pick this up on its own. Set explicitly anyway: import resolution and
		// #base merging are separate passes and the ordering between them is not worth depending on.
		"grenade_m203_smoke"
		{
			"ArmDelay"					"0"
		}
		"grenade_gp25_smoke"
		{
			"ArmDelay"					"0"
		}
		"grenade_m79_smoke"
		{
			"ArmDelay"					"0"
		}

	}
}
