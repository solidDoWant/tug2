			"sounds"
			{
				"shot_single"				"Weapon_Galil.Single"
				"shot_single_local"			"Weapon_Galil.SingleLocal"
				"shot_silent"				"Weapon_Galil.SingleSilenced"
				"shot_silent_local"			"Weapon_Galil.SingleSilencedLocal"
				"empty"						"Weapon_Galil.Empty"
				"clipin"					"Weapon_Galil.Magin"
				"clipout"					"Weapon_Galil.Magout"
				"boltback"					"Weapon_Galil.Boltback"
