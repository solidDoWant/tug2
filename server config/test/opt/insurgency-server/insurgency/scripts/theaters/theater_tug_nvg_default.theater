// TUG theater + night vision - shipped by this repo, not by the TUG Scripts workshop item.
//
// mp_theater_override points here (server.cfg and the playlist) instead of at
// theater_tug_39_medicbomber_12p_default. This file inherits that theater wholesale via #base and
// changes exactly one thing: every security class may now buy sec_nightvision.
//
// sec_nightvision is already defined by TUG's own gear file (accessory slot, cost 0, weight 0);
// it was simply never listed in any class's allowed_items, so nothing could buy it.
//
// WHY THE FULL LISTS ARE RESTATED BELOW: KeyValues #base merging matches children by NAME and
// takes the FIRST match only (tier1/KeyValues.cpp, RecursiveMergeKeyValues). Every entry in
// allowed_items is named "gear" or "weapon", so declaring a single extra "gear" here would
// collapse all of the inherited "gear" entries onto it and silently delete the armour and rig
// options. Restating each list in full is what keeps them. buy_order is deliberately NOT declared,
// so it is inherited untouched and nobody's default loadout changes.
//
// This means the lists below are a snapshot. If TUG Scripts is updated and a class gains gear,
// re-extract from the workshop VPK rather than hand-editing.

"#base" "theater_tug_39_medicbomber_12p_default.theater"

"theater"
{
	"player_templates"
	{
		// ---------------------------------------------------------------------------
		// Bot loadout variants
		// ---------------------------------------------------------------------------
		// Bot equipment is DETERMINISTIC: CPlayerInventory::PurchaseClassTemplateItems and
		// GiveItemsFromTemplate contain no RNG. A bot gets exactly its template's buy_order, so with
		// 8 bot templates filling 48 cell slots you saw 8 loadouts on repeat. Variety therefore has
		// to come from having more templates.
		//
		// allowed_items IS read for bots - an earlier version of this file assumed it was not, and
		// every machine gun, weapon_m84 and weapon_m18_ins in these templates was silently refused
		// at spawn with Invalid player (1) in the console. The follow-on Invalid definition (3)
		// errors for that weapon's attachments are a cascade of it, not a separate fault.
		// Restricted items must be listed in the template's own allowed_items; default items
		// (rifles, pistols, weapon_kabar, weapon_molotov, weapon_f1) work without it. Compare stock
		// TUG: template_coop_machinegunner allowlists weapon_rpk, template_coop_heavygunner
		// weapon_m240, template_coop_specialist weapon_m84 and weapon_m18_ins, and
		// template_support_security_coop every MG it can carry. allowed_items ADDS to the defaults
		// rather than replacing them, which is why those stock templates never list their own gear
		// or weapon_kabar. Each template below therefore allowlists exactly the weapons it buys.
		//
		// These are NEW template names, so unlike the security classes above nothing is being
		// overridden and no full-list restatement is needed. team/print_name/models are copied
		// from the matching TUG archetype so the bots look unchanged.
		//
		// Every weapon is team_access insurgent and every attachment was checked against that
		// upgrade's own allowed_weapons list. Do not hand-add attachments without checking:
		// underbarrel_foregrip_ins2 is weapon_toz only and magazine_drum_75rd is galil only,
		// despite what their names suggest.
		"template_tugvar_fighter_ak74"
		{
			"team"					"security,insurgents"
			"print_name"				"#Squad_Cell_Fighter"
			"models"
			{
			"player"				"models/characters/insurgent_heavy.mdl"
			"viewmodel_hands"			"models/weapons/v_hands_ins_h.mdl"

			"bodygoups"
			{
			"kit"					"0"
			"backpack"				"0"
			}

			"attachments"
			{
			"helmet"
			{
			"model"			"models/characters/ins_helmet_head.mdl"
			}
			}
			}
			"buy_order"
			{
				"gear"					"ins_heavy_armor"
				"gear"					"ins_chest_carrier"
				"weapon"				"weapon_kabar"
				"weapon"				"weapon_ak74"
				"weapon_upgrade"		"ammo_ap_ak74"
				"weapon_upgrade"		"optic_2xaimpoint"
				"weapon_upgrade"		"magazine_extended_akseries_45rd"
				"weapon"				"weapon_f1"
			}
			"allowed_items"
			{
				"weapon"				"weapon_kabar"
				"weapon"				"weapon_ak74"
				"weapon"				"weapon_f1"
			}
		}
