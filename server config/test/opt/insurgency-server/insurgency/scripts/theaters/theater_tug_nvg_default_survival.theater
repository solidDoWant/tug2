// TUG survival theater. Inherits theater_tug_nvg_default.theater (TUG's theater plus the
// night vision option) and supplies this mode's squads.
// Security squads copied from _checkpoint; insurgents (the players here) cut to 12 slots. Survival
// starts players with minimal gear and no respawns.
// Only the 12p variant exists, because server.cfg sets the 12p override.

"#base" "theater_tug_nvg_default.theater"

"theater"
{
	"teams"
	{
		"security"
		{
			"squads"
			{
				// assault squad
				"#Fireteam_Alpha"	// small arms
				{
					"#Squad_Fireteam_WeaponsSgt"			"template_recon_security_coop"
					"#Squad_Fireteam_WeaponsSpecialistA"	"template_rifleman_security_coop"
					"#Squad_Fireteam_WeaponsSpecialistB"	"template_designated_marksman_security_coop"
					"#Squad_Fireteam_WeaponsSpecialistC"	"template_specialist_security_coop"
					"#Squad_Fireteam_MGSpecialist"			"template_support_security_coop"
					"#Squad_Combat_Medic"					"template_combat_medic"
				}

				// assault squad
				"#Fireteam_Bravo"	// small arms
				{
					"#Squad_Fireteam_WeaponsSpecialistA"	"template_rifleman_security_coop"
					"#Squad_Fireteam_WeaponsSpecialistB"	"template_designated_marksman_security_coop"
					"#Squad_Fireteam_WeaponsSpecialistC"	"template_specialist_security_coop"
					"#Squad_Fireteam_WeaponsSpecialistD"	"template_breacher_security_coop"
					"#Squad_Fireteam_MGSpecialist"			"template_support_security_coop"
					"#Squad_Combat_Medic"					"template_combat_medic"
				}				
							
			}
		}
		
		
		"insurgents"
		{
			// Humans play THIS team in survival, so these slots are the player cap: 2 cells x 6 = 12.
			// They were checkpoint's six 8-slot cells copied verbatim (48 slots) - fine there, where
			// insurgents are bots, but survival offered all 48 to players. Survival's Security bots
			// do not use squads at all (see the waves block below), so nothing else depends on these.
			// One of each loadout, no repeats across the two cells.
			"squads"
			{
				"#Cell_Alpha"	// assault team #1
				{
					// role name								preset
					"#Squad_Cell_Leader_Specialist"			"template_tugvar_specialist_asval"	// Smoke
					"#Squad_Cell_Fighter"					"template_tugvar_fighter_stg44"	// Incendiary
					"#Squad_Cell_SubmachineGunner"			"template_tugvar_submachinegunner_uzi"	// Incendiary
					"#Squad_Cell_MachineGunner"				"template_tugvar_machinegunner_m240"	// Frag
					"#Squad_Cell_Sapper"					"template_tugvar_sapper_law"	// RPG
					"#Squad_Cell_Bomber"					"template_coop_bomber"	// bomber
				}

				"#Cell_Bravo"	// assault team #2
				{
					// role name								preset
					"#Squad_Cell_Leader_Specialist"			"template_tugvar_specialist_mp5"	// smokes
					"#Squad_Cell_Fighter"					"template_tugvar_fighter_ak74"	// incendiary
					"#Squad_Cell_SubmachineGunner"			"template_tugvar_submachinegunner_mac10"	// incendiary
					"#Squad_Cell_MachineGunner"				"template_tugvar_machinegunner_pecheneg"	// Frag
					"#Squad_Cell_Sapper"					"template_tugvar_sapper_rpg7"	// RPG
					"#Squad_Cell_SharpShooter"				"template_tugvar_sharpshooter_mosin"	// smokes
				}
			}
		}
	}

	// =================================================================================
	// SURVIVAL'S SECURITY WAVES - REQUIRED, AND NOT REACHABLE ANY OTHER WAY
	// =================================================================================
	// Survival does NOT build its attacking waves from the "squads" above. The mode asks for a
	// fixed set of class templates BY NAME, one pair per wave plus two specialists:
	//
	//     template_survival_base_01_security .. _05_security
	//     template_survival_officer_01_security .. _05_security
	//     template_survival_m249_security
	//     template_survival_at4_security
	//
	// Those are defined in stock scripts/theaters/default_survival.theater, which is NOT in this
	// file's ancestry - the chain is theater_tug_nvg_default -> TUG's medicbomber_12p -> ... ->
	// default.theater, and default_survival is a SIBLING of default, not a parent. TUG ships no
	// _survival variant either. So nothing in the loaded theater defined them, and the engine said
	// so once per wave, all the way down:
	//
	//     Can't precache non-existant class template_survival_base_02_security
	//     Failed to find template "template_survival_base_01_security" when giving items
	//
	// A template that cannot be found gives no items, so every Security bot spawned empty handed.
	//
	// The twelve names are fixed by the mode. What is IN them is not, so they are written out below
	// rather than copied from stock - see the next block.
	//
	// These are NEW names in this chain, so nothing is being overridden and the partial-block rule
	// does not apply - same reasoning as the tugvar templates in the base theater.
	"player_templates"
	{
		// WHY THESE ARE NOT THE STOCK LOADOUTS. default_survival.theater arms all five waves out of the
		// vanilla rack - m9, mp5, ump45, m16a4, m4a1 - so none of the weapons this theater actually adds
		// ever appear on an attacker. The escalation below is the stock curve (pistol -> SMG -> rifle ->
		// silenced/AP rifle, light armour on officers, heavy on the later grunts) rebuilt out of the
		// modified rack instead, at the same supply cost per wave, so difficulty is unchanged and only
		// the hardware differs.
		//
		// Every entry was checked programmatically against the MERGED theater before being written here:
		// each weapon exists and has "security" in its team_access, each upgrade lists the weapon it is
		// mounted on in its own allowed_weapons, and each gear item resolves. That check is the reason
		// underbarrel_foregrip_scar is on the SCAR and underbarrel_foregrip_sec1 is not - the base
		// theater's bot-variant section warns about exactly this, and the names do not tell you.
		//
		// Costs run 3 -> 10 supply against mp_supply_token_bot_base 20 (stock survival) and the 35 that
		// gg2_supply tops bots up to, so every wave affords its whole kit with room to spare.

		"template_survival_base_01_security"
		{
			"team"					"security"
			"print_name"				"Security Force 01 Class"

			"models"
			{
				"player"				"models/characters/security_light.mdl"
				"viewmodel_hands"		"models/weapons/v_hands_sec_l.mdl"

				"bodygroups"
				{
					"kit"					"0"
					"backpack"				"0"
				}
			}

			// 3 supply
			"buy_order"
			{
				"gear"					"sec_chest_rig"
				"weapon"				"weapon_kabar"
				"weapon"				"weapon_glock17"
				"weapon_upgrade"			"siderail_flashlight_pistol"
				"weapon"				"weapon_m84"
			}
			"allowed_items"
			{
				"weapon"				"weapon_glock17"
				"weapon"				"weapon_kabar"
				"weapon"				"weapon_m84"
			}
		}

		"template_survival_officer_01_security"
		{
			"team"					"security"
			"print_name"				"Security Officer 01 Class"

			"models"
			{
				"player"				"models/characters/security_light.mdl"
				"viewmodel_hands"		"models/weapons/v_hands_sec_l.mdl"

				"bodygroups"
				{
					"kit"					"0"
					"backpack"				"0"
				}
			}

			// 5 supply
			"buy_order"
			{
				"gear"					"sec_chest_rig"
				"gear"					"sec_light_armor"
				"weapon"				"weapon_kabar"
				"weapon"				"weapon_glock17"
				"weapon"				"weapon_mp5a4"
				"weapon_upgrade"			"siderail_flashlight_band"
				"weapon"				"weapon_m18"
			}
			"allowed_items"
			{
				"weapon"				"weapon_glock17"
				"weapon"				"weapon_kabar"
				"weapon"				"weapon_m18"
				"weapon"				"weapon_mp5a4"
			}
		}

