	// -------------------------------------------------------------------------------------------
	// Survival prices
	// -------------------------------------------------------------------------------------------
	// Every weapon, upgrade, armor/vest, sling and NVG an insurgent can buy, re-priced for survival's
	// economy: a run starts on 2 supply and earns roughly 2-3 per level, so a full kit lands somewhere
	// in the 20s-30s and upgrades are still worth saving for at level 50. TUG prices for checkpoint, where
	// players are handed 120, so most of its catalogue costs 0-4. Other modes never load this file.
	//
	// Each entry is the effective definition copied verbatim with only the price changed - a
	// definition declared here REPLACES the inherited one (see the note atop the "weapons" block in
	// theater_tug_nvg_default.theater), so a price alone would strip the item of everything else.
	// Change prices in tools/survival-economy/generate.py and rerun it; do not edit the block.
	// ===== BEGIN GENERATED by tools/survival-economy/generate.py - do not edit by hand =====
	"weapons"
	{
		// from theater_tug_39_custom_weapon.theater
		"weapon_9mmsidearm"
		{
			"import"				"pistol_base"
			"weapon_class"				"pistol"
			"print_name"				"#weapon_9mmsidearm"
			"print_desc"				"#weapon_9mmsidearm_desc"
			"view_model"				"models/weapons/v_dark9mm.mdl"
			"world_model"				"models/weapons/w_d9.mdl"
			"rounds_per_minute"			"600"
			"weapon_slot"				"secondary"
			"act_table"				"pistol"
			"weapon_abilities"			"ironsight"
			"weapon_weight"				"0"
			"weapon_cost"				"0"
			"class_restricted"			"0"
			"barrel_length"				"0"	
			"reload_speed"				"1.6"				
			
			"fov"
			{
				"fov_plr_ironsight"			"-10"
				"fov_plr_focus"				"-10"
				"fov_wpn_default"			"74"
				"fov_wpn_ironsight"			"74"
				"fov_wpn_focus"				"79"
			}
			"viewmodel_offsets"
			{
				// x back, y left, z down
				"VMOffsetStand"				"0.15 0.25 0.75"
			}
			"sounds"
			{
				"shot_single"				"Weapon_9mmsidearm.Single"
				"shot_single_local"			"Weapon_9mmsidearm.SingleLocal"
				"shot_silent"				"Weapon_MK20.SingleSilenced"
				"shot_silent_local"			"Weapon_MK20.SingleSilencedLocal"
